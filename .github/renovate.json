{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>jpaju/gh-commons//renovate/default"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^media/versions\\.json$/"
      ],
      "matchStrings": [
        "\"musicAssistant\":\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "ghcr.io/music-assistant/server",
      "datasourceTemplate": "docker"
    }
  ]
}